  "name": "atrament-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build:frontend": "pnpm --filter @atrament/frontend run build",
    "check:frontend": "pnpm --filter @atrament/frontend run check",
