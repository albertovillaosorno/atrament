{
  "license": "MIT",
  "name": "atrament-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build:frontend": "pnpm --filter @atrament/frontend run build",
    "check:frontend": "pnpm --filter @atrament/frontend run check",
    "test:frontend":
      "node --test --test-concurrency=1 tests/browser/*/*/*.mjs",
    "test:flow":
      "node tests/backend/profile-editor-cli/composition/flow-shards.mjs",
    "test:cli-files":
      "node --test tests/backend/profile-editor-cli/composition/main.mjs",
    "test:print-ready":
      "node --test tests/backend/*/composition/print-ready-workflow.mjs",
    "test:joined-ink":
      "node --test tests/backend/*/composition/joined-varied-handwriting.mjs",
    "test:handwriting":
      "node --test --test-concurrency=1 tests/backend/*/composition/*hand*.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
