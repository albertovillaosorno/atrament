{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2024",
    "rootDir": "adapter-inbound",
    "outDir": "../../../.cache/frontend"
  },
  "include": [
    "adapter-inbound/**/*.ts"
  ]
}
